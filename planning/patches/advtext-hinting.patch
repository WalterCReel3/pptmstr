+
+    def laid_out(em_px: float) -> list[Glyph]:
+        """
+        The word as the layout core sets it from the file: advance, then kern.
+        """
+        key = font_key(Face.PROSE, sp_from_px(em_px))
+        metrics = fontlib_metrics(key)
+        commands, x = [], 0
+        for index, character in enumerate(word):
+            commands.append(
+                Glyph(font=key, codepoint=ord(character), x=x, y=sp_from_px(30.0), index=index)
+            )
+            x += round(metrics.advance(ord(character)))
+            if index + 1 < len(word):
+                x += round(metrics.kern(ord(character), ord(word[index + 1])))
+        return commands
+
+    em_of_16_high = em_size_for_pixel_height(Face.PROSE, 16.0)
+    rows: list[tuple[str, int, int]] = []
+    imgui.new_frame()
+    draw_list = imgui.get_background_draw_list()
+    top = 4.0
+    for mode, font in fonts.items():
+        native = [(f"add_text at {size:g}", size, None) for size in (16.0, 19.0, 18.75)]
+        ours = [("draw, 16 px em", None, 16.0), ("draw, 16 px height", None, em_of_16_high)]
+        for label, size, em_px in native + ours:
+            first = draw_list.vtx_buffer.size()
+            origin = imgui.ImVec2(100.0, top)
+            if size is not None:
+                draw_list.add_text(font, size, origin, 0xFFFFFFFF, word)
+            else:
+                assert em_px is not None
+                draw(draw_list, laid_out(em_px), origin, fonts=lambda _face, font=font: font)
+            rows.append((f"{mode.value:<8} {label}", first, draw_list.vtx_buffer.size()))
+            top += ROW_PX
+    imgui.render()
+
+    textures = io.fonts.tex_list
+    if textures.size() != 1:
+        print(f"{textures.size()} atlas textures; this script reads exactly one", file=sys.stderr)
+        return 2
+    texture = textures[0]
+    pixels = np.asarray(texture.get_pixels_array()).reshape(
+        texture.height, texture.width, texture.bytes_per_pixel
+    )
+    alpha = pixels[:, :, texture.bytes_per_pixel - 1].astype(np.float64) / 255.0
+
+    def texel(column: int, row: int) -> float:
+        row = min(max(row, 0), texture.height - 1)
+        column = min(max(column, 0), texture.width - 1)
+        return float(alpha[row, column])
+
+    def sample(u: float, v: float) -> float:
+        """
+        The atlas at a texture coordinate, bilinear, texel centres at half-integers.
+        """
+        x, y = u * texture.width - 0.5, v * texture.height - 0.5
+        x0, y0 = math.floor(x), math.floor(y)
+        fx, fy = x - x0, y - y0
+        return (
+            texel(x0, y0) * (1 - fx) * (1 - fy)
+            + texel(x0 + 1, y0) * fx * (1 - fy)
+            + texel(x0, y0 + 1) * (1 - fx) * fy
+            + texel(x0 + 1, y0 + 1) * fx * fy
+        )
+
+    canvas = np.zeros((int(top + ROW_PX), 512))
+    buffer = draw_list.vtx_buffer
+    print(f"loader: {io.fonts.font_loader_name};  word {word!r};  Roboto\n")
+    head = ("hinting  path", "quads", "off-grid", "solid", "midtone", "inked")
+    print("{:<30} {:>5} {:>8} {:>7} {:>8} {:>6}".format(*head))
+    for label, first, last in rows:
+        off_grid = quads = 0
+        tops: list[float] = []
+        for start in range(first, last, 4):
+            corners = [buffer[index] for index in range(start, start + 4)]
+            x0, x1 = min(c.pos.x for c in corners), max(c.pos.x for c in corners)
+            y0, y1 = min(c.pos.y for c in corners), max(c.pos.y for c in corners)
+            u0, u1 = min(c.uv.x for c in corners), max(c.uv.x for c in corners)
+            v0, v1 = min(c.uv.y for c in corners), max(c.uv.y for c in corners)
+            quads += 1
+            off_grid += x0 != int(x0) or y0 != int(y0)
+            tops += [y0, y1]
+            for row in range(math.floor(y0), math.ceil(y1)):
+                for column in range(math.floor(x0), math.ceil(x1)):
+                    cx, cy = column + 0.5, row + 0.5
+                    if not (x0 <= cx < x1 and y0 <= cy < y1):
+                        continue
+                    cover = sample(
+                        u0 + (cx - x0) / (x1 - x0) * (u1 - u0),
+                        v0 + (cy - y0) / (y1 - y0) * (v1 - v0),
+                    )
+                    canvas[row, column] = cover + canvas[row, column] * (1.0 - cover)
+        if not quads:
+            print(f"{label:<30} NO QUADS -- nothing measured")
+            continue
+        region = 255.0 * (1.0 - canvas[math.floor(min(tops)) : math.ceil(max(tops)), :])
+        profile = visual_diff.ink_profile(region)
+        print(
+            f"{label:<30} {quads:>5} {off_grid:>8} {profile.solid_share * 100:>6.1f}% "
+            f"{profile.midtone_share * 100:>7.1f}% {profile.inked:>6}"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
