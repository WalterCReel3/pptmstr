+def test_a_pair_kern_is_a_whole_pixel_where_the_advance_before_it_is() -> None:
+    """
+    After a whole-pixel advance the kern is rounded the way the gap will be drawn.
+
+    -1.25 px goes to -1: `draw` sets the gap at `snap_px(9 - 1.25)`, which is 8,
+    so a layout that believed 7.75 would be a quarter pixel narrower than the
+    word on screen.
+    """
+    metrics = _resolver(_Font({ord("A"): 9.0, ord("V"): 9.0}))(KEY)
+
+    assert px_from_sp(round(metrics.kern(ord("A"), ord("V")))) == pytest.approx(-1.0, abs=1e-4)
+    assert metrics.kern(ord("V"), ord("A")) == 0.0
+
+
+def test_a_pair_kern_is_the_file_s_where_the_advance_before_it_is_fractional() -> None:
+    """
+    Unhinted, or at a density above 1, the kern is not rounded here.
+
+    The gap is `snap_px` of a fractional sum either way, so rounding the kern
+    first would be a second rounding of the same gap.
+    """
+    file = _FileMetrics(KEY)
+    metrics = _resolver(_Font({ord("A"): 8.75, ord("V"): 9.0}))(KEY)
+
+    assert metrics.kern(ord("A"), ord("V")) == file.kern(ord("A"), ord("V"))
+
+
+def test_a_reloaded_face_is_measured_from_its_new_font() -> None:
+    """
+    What a resolver holds for a key is dropped when the role's `ImFont` changes.
+
+    Including from no font at all to one, which is a face `load_pending` loaded
+    after a layout had already asked about it.
+    """
+    held: list[Any] = [None]
+    resolve = baked_metrics(lambda _face: held[0], file=_FileMetrics)
+    file = _FileMetrics(KEY)
+    assert resolve(KEY).advance(ord("A")) == file.advance(ord("A"))
+
+    held[0] = _Font({ord("A"): 9.0})
+    assert px_from_sp(round(resolve(KEY).advance(ord("A")))) == pytest.approx(9.0, abs=1e-4)
+
+    held[0] = _Font({ord("A"): 10.0})
+    assert px_from_sp(round(resolve(KEY).advance(ord("A")))) == pytest.approx(10.0, abs=1e-4)
+
+    held[0].advances[ord("A")] = 11.0
+    assert px_from_sp(round(resolve(KEY).advance(ord("A")))) == pytest.approx(10.0, abs=1e-4)
+    resolve.clear()
+    assert px_from_sp(round(resolve(KEY).advance(ord("A")))) == pytest.approx(11.0, abs=1e-4)
+
+
+def test_the_math_face_is_answered_from_the_file() -> None:
+    """
+    A formula's advances are read with numbers only the file states, so they stay there.
+    """
+    key = font_key(Face.MATH, sp_from_px(16.0))
+    font = _Font({ord("A"): 9.0})
+    seen: list[Any] = []
+
+    def file(asked: str) -> Any:
+        seen.append(_FileMetrics(asked))
+        return seen[-1]
+
+    resolve = baked_metrics(lambda _face: font, file=file)
+
+    assert resolve(key) is seen[0]
+    assert resolve(key) is seen[0] and len(seen) == 1
+    assert font.asked == []
