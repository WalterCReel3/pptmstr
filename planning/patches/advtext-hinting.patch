+#!/usr/bin/env python3
+"""
+The ink of one word drawn by ImGui's own `add_text` and by `advtext`'s `draw`.
+
+`docs/advance-rule.md` §7 records an anomaly: ImGui's own text measured softer
+than this project's on the same face, atlas and frame, with every pen of both on
+a whole pixel. The harness that measured it was never committed. This is the
+instrument for the question it left -- is that a property of ImGui's text path,
+of the hinting mode, or of the comparison -- committed so the answer can be
+re-derived.
+
+## What it does
+
+One atlas, the prose face loaded once under each `advtext.ui.fonts.Hinting`
+mode. For each mode the word is put on one draw list five ways:
+
+    ImGui's `add_text` at a 16 px height
+    ImGui's `add_text` at a 19 px height
+    ImGui's `add_text` at 18.75, the unrounded height of a 16 px em
+    `draw`, laid out at a 16 px em        (which `_baked` draws from the 19 px raster)
+    `draw`, laid out at a 16 px height
+
+Each is then composited **on the CPU**: every quad in the vertex buffer is
+filled from the atlas's own pixels with bilinear filtering, which is what a
+renderer with a linear sampler does, and `scripts/visual_diff.py`'s
+`ink_profile` is taken of the result.
+
+## What that can and cannot say
+
+A quad at a whole-pixel position, one texel to one pixel, composites to the
+same pixels under any filter, so for those rows this is exact. A resampled quad
+is filtered here by hand; a GPU's rounding of the same arithmetic may differ in
+the last bit. **No window is opened and no screenshot is taken**, the ink is
+black on white rather than a palette on a page, and the shares are therefore
+comparable between rows of this script and not with a figure read off a
+screenshot. `ink_profile`'s own docstring says what a midtone share is and is
+not evidence of.
+
+    .venv/bin/python scripts/ink_by_path.py
+    .venv/bin/python scripts/ink_by_path.py difference
+
+Needs numpy, as `scripts/visual_diff.py` does.
+"""
+
+from __future__ import annotations
+
+import argparse
+import math
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+ROW_PX = 40.0
+"""
+The distance between rows. Fifteen rows have to fit the 768 px display the
+frame declares, because the background draw list clips to it and a clipped
+glyph appends no vertices.
+"""
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[1])
+    parser.add_argument("word", nargs="?", default="people")
+    args = parser.parse_args(argv)
+    word = args.word
+
+    sys.path[:0] = [str(ROOT), str(ROOT / "scripts")]
+    import numpy as np
+    import visual_diff
+    from imgui_bundle import imgui
+
+    from advtext import fontlib
+    from advtext.backends.imgui_draw import draw
+    from advtext.fontmetrics import Face
+    from advtext.shipout import Glyph
+    from advtext.style import font_key, fontlib_metrics
+    from advtext.ui.fonts import Hinting, atlas_loader, em_size_for_pixel_height
+    from advtext.units import sp_from_px
+
