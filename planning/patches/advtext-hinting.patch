+@pytest.mark.parametrize("mode", list(Hinting))
+def test_the_resolver_a_load_returns_gives_the_advance_the_atlas_baked(
+    loaded: dict[Hinting, LoadedFaces], mode: Hinting
+) -> None:
+    """
+    Under every mode, `loaded.metrics()` and the atlas agree about every advance.
+
+    Exactly, to the scaled point, under the hinted modes, where the resolver
+    read the atlas; to `ADVANCE_TOLERANCE_PX` under `NONE`, where it read the
+    file.
+    """
+    fonts = loaded[mode]
+    resolve = fonts.metrics()
+    bound = ADVANCE_TOLERANCE_PX if mode is Hinting.NONE else 1e-4
+    for face, height, codepoint in _cases():
+        key = _key(face, height)
+        ours = px_from_sp(round(resolve(key).advance(codepoint)))
+        theirs = _baked_px(fonts(face), key, codepoint)
+        assert abs(ours - theirs) <= bound, (mode, face, height, chr(codepoint), ours, theirs)
+
+
+def _set(text: str, key: str, resolve: Any) -> list[Glyph]:
+    """
+    A word laid out the way the layout core lays one out: advance, then kern.
+
+    Each rounded to a scaled point on its own, as `char_measure` and a kern
+    node round them.
+    """
+    metrics = resolve(key)
+    commands: list[Glyph] = []
+    x = sp_from_px(3.0)
+    for index, character in enumerate(text):
+        commands.append(
+            Glyph(font=key, codepoint=ord(character), x=x, y=sp_from_px(40.0), index=index)
+        )
+        x += round(metrics.advance(ord(character)))
+        if index + 1 < len(text):
+            x += round(metrics.kern(ord(character), ord(text[index + 1])))
+    return commands
+
+
+class _RecordingDrawList:
+    """
+    A draw list that keeps the pen of every `add_text` instead of drawing.
+    """
+
+    def __init__(self) -> None:
+        self.flags = 0
+        self.pens: list[float] = []
+
+    def add_text(self, _font: Any, _size: float, position: Any, _colour: int, _text: str) -> None:
+        self.pens.append(position.x)
+
+
+@pytest.mark.parametrize("mode", [Hinting.DEFAULT, Hinting.LIGHT])
+@pytest.mark.parametrize("face", FACES)
+def test_a_word_laid_out_from_the_baked_resolver_is_drawn_at_the_width_it_was_laid_out_at(
+    imgui_context: Any, loaded: dict[Hinting, LoadedFaces], mode: Hinting, face: Face
+) -> None:
+    """
+    Hinted faces, the matching resolver: every pen is where the layout put it.
+
+    The step from one glyph to the next is the atlas's advance plus a
+    whole-pixel kern, so `_RigidSpan.pen`'s rounding finds nothing to round and
+    the word ends exactly where the layout believes it does. That is the
+    property the mismatched pair lacks -- under it a word's width moves by up
+    to 2 px (`docs/advance-rule.md` §4) and the difference lands in the space
+    after it.
+    """
+    fonts = loaded[mode]
+    resolve = fonts.metrics()
+    for height in HEIGHTS_PX:
+        key = _key(face, height)
+        for word in SAMPLE.split():
+            commands = _set(word, key, resolve)
+            recorder = _RecordingDrawList()
+            draw(
+                recorder, commands, imgui_context.ImVec2(40.25, 10.0), fonts=fonts, metrics=resolve
+            )
+            laid = [px_from_sp(cmd.x - commands[0].x) for cmd in commands]
+            drawn = [pen - recorder.pens[0] for pen in recorder.pens]
+            assert drawn == pytest.approx(laid, abs=1e-3), (mode, face, height, word)
+
+
+def test_a_layout_from_the_file_is_reported_against_hinted_faces_and_not_against_unhinted_ones(
+    loaded: dict[Hinting, LoadedFaces],
+) -> None:
+    """
+    `check_advances` tells the mismatched pair from the matched ones, both ways.
+
+    The mismatched pair is this library's default: the loader's flags and
+    `fontlib_metrics`. In monospace every glyph disagrees.
+    """
+    key = _key(Face.CODE, 16.0)
+    commands = _set("people", key, fontlib_metrics)
+    distinct = len(set("people"))
+
+    hinted = check_advances(commands, fonts=loaded[Hinting.DEFAULT])
+    assert not hinted.agrees
+    assert (hinted.glyphs, hinted.disagreeing) == (distinct, distinct)
+    assert hinted.worst_px == pytest.approx(0.374 - ADVANCE_TOLERANCE_PX, abs=0.005)
+
+    unhinted = check_advances(commands, fonts=loaded[Hinting.NONE])
+    assert unhinted.agrees and unhinted.glyphs == distinct and unhinted.worst_px == 0.0
+
+
+@pytest.mark.parametrize("mode", list(Hinting))
+def test_the_resolver_a_load_returns_is_never_reported(
+    loaded: dict[Hinting, LoadedFaces], mode: Hinting
+) -> None:
+    """
+    Whatever the mode, laying out with `loaded.metrics()` passes the check.
+
+    At whole pixel heights and at a fractional one -- a 16 px em is an 18.75 px
+    height in Roboto, drawn from the 19 px raster -- which is the case the
+    size allowance in `check_advances` exists for under `Hinting.NONE`.
+    """
+    fonts = loaded[mode]
+    resolve = fonts.metrics()
+    keys = [_key(face, height) for face in FACES for height in HEIGHTS_PX]
+    keys += [font_key(face, sp_from_px(16.0)) for face in FACES]
+    for key in keys:
+        found = check_advances(_set(SAMPLE, key, resolve), fonts=fonts, metrics=resolve)
+        assert found.agrees and found.glyphs == len(set(SAMPLE)), (mode, key, found)
+
+
+def test_a_baked_resolver_over_unhinted_faces_agrees_too(
+    loaded: dict[Hinting, LoadedFaces],
+) -> None:
+    """
+    Asking the atlas is right under every mode; the file is right under one.
+
+    So a host that cannot say how its loader hints can use `baked_metrics`
+    regardless, and one that says `Hinting.NONE` wrongly is caught by the check.
+    """
+    fonts = loaded[Hinting.NONE]
+    resolve = baked_metrics(fonts)
+    key = _key(Face.PROSE, 16.0)
+
+    assert check_advances(_set(SAMPLE, key, resolve), fonts=fonts, metrics=resolve).agrees
+
+    hinted = loaded[Hinting.DEFAULT]
+    said_none = LoadedFaces(lambda _path: hinted(Face.PROSE), hinting=Hinting.NONE)
+    said_none.load([Face.PROSE])
+    wrong = said_none.metrics()
+    assert wrong is fontlib_metrics
+    assert not check_advances(_set(SAMPLE, key, wrong), fonts=said_none, metrics=wrong).agrees
+
