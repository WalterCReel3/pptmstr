@@ -0,0 +1,641 @@
+r"""
+The hinting mode a face is baked under, and the resolver that agrees with it.
+
+`advtext.ui.fonts` argues that an advance belongs to the rasteriser. These tests
+hold the three things that argument needs to be true in this build, and then the
+pairing that follows from them.
+
+- **What the rasteriser does** is pinned against a real `ImFontAtlas`: hinted
+  advances are whole pixels and are not the file's, unhinted ones are the
+  file's. These are facts about imgui-bundle's loader and not about this
+  project, and they are pinned for the reason `tests/test_makefile_env.py` pins
+  a flag's existence: the release that changes one should go red here rather
+  than somewhere that looks unrelated.
+- **What the resolver does** is tested twice: with fakes whose numbers are
+  round, for the rules (which advance, which kern, what a reload costs), and
+  against the real atlas, for agreement with it.
+- **That a mismatched pair is detectable** is `check_advances`, against the
+  real atlas, in both directions.
+
+**No window is opened and nothing is composited.** Every assertion is about an
+advance the atlas reports or a pen `draw` hands `add_text`. One density, 1.0.
+
+The faces loaded here stay in the session's atlas, as every other module's do;
+`tests/test_imgui_draw.py`'s `imgui_context` says why nothing is torn down.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from advtext import fontlib
+from advtext.backends.imgui_draw import (
+    ADVANCE_TOLERANCE_PX,
+    baked_size_px,
+    check_advances,
+    draw,
+    snap_px,
+)
+from advtext.fontmetrics import Face, GlyphBBox
+from advtext.shipout import Glyph
+from advtext.style import font_key, fontlib_metrics, parse_font_key
+from advtext.ui.fonts import (
+    BakedFaceMetrics,
+    Hinting,
+    LoadedFaces,
+    atlas_loader,
+    baked_metrics,
+    em_size_for_pixel_height,
+    load_faces,
+)
+from advtext.units import px_from_sp, sp_from_px
+
+imgui_bundle = pytest.importorskip("imgui_bundle")
+
+FACES = (Face.PROSE, Face.PROSE_BOLD, Face.CODE)
+"""
+A proportional face with instructions, its bold, and the monospace.
+
+Roboto is where the hinter's advance departs from the rounded file advance, and
+Inconsolata is where the departure is the same for every glyph and so adds up.
+"""
+
+HEIGHTS_PX = (13.0, 14.0, 16.0, 20.0)
+"""
+Whole pixel heights, as a host states a UI font size.
+"""
+
+SAMPLE = "people difference iiii mmmm The quick brown fox AV To Wa 0123456789 .,;:()"
+
+
+@pytest.fixture(scope="module")
+def imgui_context() -> Any:
+    """
+    The process's ImGui context, made if no other test module has made one.
+
+    The recipe of `tests/test_fonts_setup.py`'s fixture: no backend, no window,
+    no frame.
+    """
+    from imgui_bundle import imgui
+
+    if imgui.get_current_context() is None:
+        imgui.create_context()
+    io = imgui.get_io()
+    io.display_size = imgui.ImVec2(1024.0, 768.0)
+    io.delta_time = 1.0 / 60.0
+    io.backend_flags |= imgui.BackendFlags_.renderer_has_textures.value
+    return imgui
+
+
+@pytest.fixture(scope="module")
+def loaded(imgui_context: Any) -> dict[Hinting, LoadedFaces]:
+    """
+    The same faces loaded once under each mode, into the one atlas.
+    """
+    return {mode: load_faces(FACES, hinting=mode) for mode in Hinting}
+
+
+def _key(face: Face, height_px: float) -> str:
+    """
+    The font key at which a face comes out `height_px` tall, as a host would build it.
+    """
+    return font_key(face, sp_from_px(em_size_for_pixel_height(face, height_px)))
+
+
+def _baked_px(font: Any, key: str, codepoint: int) -> float:
+    """
+    The atlas's advance for a glyph at the size `draw` asks for, read independently.
+    """
+    spec = parse_font_key(key)
+    file = fontlib_metrics(key)
+    size_px = baked_size_px(px_from_sp(spec.size), file.ascent, file.descent, file.em)
+    return float(font.get_font_baked(size_px).get_char_advance(codepoint))
+
+
+def _cases() -> list[tuple[Face, float, int]]:
+    return [
+        (face, height, ord(character))
+        for face in FACES
+        for height in HEIGHTS_PX
+        for character in sorted(set(SAMPLE))
+    ]
+
+
+# ----------------------------------------------------------------------
+# What the rasteriser does
+
+
+def test_the_atlas_is_baked_by_freetype(imgui_context: Any) -> None:
+    """
+    The loader this module's flags are written for is the one in the build.
+
+    `font_loader_name` is empty until a frame has run, so one is run. A build on
+    stb_truetype would ignore `font_loader_flags` and every test below that
+    expects a hinted advance would fail for that reason; this says so first.
+    """
+    imgui = imgui_context
+    imgui.new_frame()
+    imgui.render()
+    assert str(imgui.get_io().fonts.font_loader_name).startswith("FreeType")
+
+
+@pytest.mark.parametrize("mode", [Hinting.DEFAULT, Hinting.LIGHT])
+def test_a_hinted_advance_is_a_whole_pixel(
+    loaded: dict[Hinting, LoadedFaces], mode: Hinting
+) -> None:
+    fonts = loaded[mode]
+    for face, height, codepoint in _cases():
+        advance = _baked_px(fonts(face), _key(face, height), codepoint)
+        assert advance == round(advance), (mode, face, height, chr(codepoint), advance)
+
+
+def test_an_unhinted_advance_is_the_file_s(loaded: dict[Hinting, LoadedFaces]) -> None:
+    """
+    Under `Hinting.NONE` the file and the atlas agree to a hundredth of a pixel.
+
+    At whole pixel heights, where the size `draw` asks for is the size that was
+    laid out. `ADVANCE_TOLERANCE_PX` is the bound `check_advances` uses and is
+    larger than what is seen here.
+    """
+    fonts = loaded[Hinting.NONE]
+    worst = 0.0
+    for face, height, codepoint in _cases():
+        key = _key(face, height)
+        file_px = px_from_sp(round(fontlib_metrics(key).advance(codepoint)))
+        worst = max(worst, abs(file_px - _baked_px(fonts(face), key, codepoint)))
+    assert worst <= 0.01 < ADVANCE_TOLERANCE_PX, worst
+
+
+def test_a_hinted_monospace_advance_is_not_the_file_s_for_any_glyph(
+    loaded: dict[Hinting, LoadedFaces],
+) -> None:
+    """
+    The case that adds up: Inconsolata at 16 px is 8 in the atlas and 7.63 in the file.
+
+    Every glyph errs the same way, so a line laid out from the file is 5% shorter
+    than the line that is drawn.
+    """
+    key = _key(Face.CODE, 16.0)
+    file_px = px_from_sp(round(fontlib_metrics(key).advance(ord("m"))))
+    assert file_px == pytest.approx(7.626, abs=0.005)
+    for mode in (Hinting.DEFAULT, Hinting.LIGHT):
+        for character in SAMPLE:
+            assert _baked_px(loaded[mode](Face.CODE), key, ord(character)) == 8.0
+
+
+def test_light_hinting_rounds_the_file_s_advance_and_the_default_does_not(
+    loaded: dict[Hinting, LoadedFaces],
+) -> None:
+    """
+    The two hinted modes are different rasters with different advances.
+
+    Light hinting fits vertically only and its advance is the file's, rounded:
+    never more than half a pixel away, give or take the rasteriser's 1/64. The
+    default runs the font's own instructions, which move an advance further --
+    Roboto's `m` at 14 px is 10.47 in the file, 10 under light and 11 by
+    default. So `LIGHT` is distinguishable by its advances and not only by its
+    outlines, which is why `Hinting` names it.
+    """
+    key = _key(Face.PROSE, 14.0)
+    file_px = px_from_sp(round(fontlib_metrics(key).advance(ord("m"))))
+    assert file_px == pytest.approx(10.469, abs=0.005)
+    assert _baked_px(loaded[Hinting.LIGHT](Face.PROSE), key, ord("m")) == 10.0
+    assert _baked_px(loaded[Hinting.DEFAULT](Face.PROSE), key, ord("m")) == 11.0
+
+    for face, height, codepoint in _cases():
+        key = _key(face, height)
+        file_px = px_from_sp(round(fontlib_metrics(key).advance(codepoint)))
+        light = _baked_px(loaded[Hinting.LIGHT](face), key, codepoint)
+        assert abs(light - file_px) <= 0.5 + ADVANCE_TOLERANCE_PX, (face, height, chr(codepoint))
+
