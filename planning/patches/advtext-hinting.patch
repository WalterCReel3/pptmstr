+    ) -> None:
+        self._file = file
+        self._font = font
+        self._height_px = height_px
+        self._px_per_inch = px_per_inch
+        self._baked_px: dict[int, float | None] = {}
+
+    @property
+    def font(self) -> imgui.ImFont | None:
+        """
+        The loaded face the advances are read from, or `None` if there was none.
+        """
+        return self._font
+
+    @property
+    def face(self) -> Face:
+        return self._file.face
+
+    @property
+    def size(self) -> float:
+        return self._file.size
+
+    @property
+    def ascent(self) -> float:
+        return self._file.ascent
+
+    @property
+    def descent(self) -> float:
+        return self._file.descent
+
+    @property
+    def x_height(self) -> float:
+        return self._file.x_height
+
+    @property
+    def em(self) -> float:
+        return self._file.em
+
+    @property
+    def space_width(self) -> float:
+        return self.advance(0x20)
