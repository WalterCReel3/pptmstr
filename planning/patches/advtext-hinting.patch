+def test_a_glyph_with_no_raster_and_a_role_with_no_face_are_not_compared(
+    loaded: dict[Hinting, LoadedFaces],
+) -> None:
+    fonts = loaded[Hinting.DEFAULT]
+    arrow = Glyph(font=_key(Face.PROSE, 16.0), codepoint=0x2192, x=0, y=0, index=0)
+    math = Glyph(font=font_key(Face.MATH, sp_from_px(16.0)), codepoint=ord("x"), x=0, y=0, index=1)
+
+    assert not fonts(Face.PROSE).is_glyph_in_font(0x2192)
