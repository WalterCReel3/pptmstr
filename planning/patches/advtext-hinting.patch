+ADVANCE_TOLERANCE_PX = 1.0 / 64.0
+"""
+How far a laid-out advance may be from the baked one and still be the same advance.
+
+FreeType states an advance in 26.6 fixed point, so an unhinted one is the file's
+to the nearest 1/64 px and no closer: the worst `tests/test_hinting.py` sees is
+under 0.01 px. One unit of that grid is therefore agreement, and a hinted
+advance measured from the file misses it by tenths of a pixel.
+"""
+
+
+@dataclass(frozen=True, slots=True)
+class AdvanceCheck:
+    """
+    Whether a layout's advances are the advances of the glyphs that will be drawn.
+
+    `glyphs` counts the distinct (font key, codepoint) pairs that could be
+    compared, `disagreeing` those further apart than the allowance
+    `check_advances` describes, and `worst_px` is the largest amount by which
+    any pair exceeded it.
+    """
+
+    glyphs: int = 0
+    disagreeing: int = 0
+    worst_px: float = 0.0
+
+    @property
+    def agrees(self) -> bool:
+        """
+        No glyph was laid out at an advance the atlas does not have.
+        """
+        return self.disagreeing == 0
+
+
+def check_advances(
+    cmds: Iterable[DrawCmd],
+    *,
+    fonts: FaceFont,
+    metrics: MetricsResolver = fontlib_metrics,
+    px_per_inch: float = DEFAULT_PX_PER_INCH,
+) -> AdvanceCheck:
+    """
+    Compare the advances a command list was laid out with against the atlas's.
+
+    "The same resolver measures and draws" is a contract nothing enforces, and
+    it is not quite the one that matters: a resolver can be handed to every
+    stage and still describe a raster the atlas does not hold, which is what
+    `fontlib_metrics` does for faces baked with a hinter. This asks the question
+    directly -- for every glyph the commands draw, is `metrics`' advance the one
+    `ImFontBaked.get_char_advance` gives at the size `draw` will draw it at --
+    and it is the check to run once after choosing a resolver, or in a test.
+    `draw` does not run it: it costs two calls for every distinct glyph and
+    answers the same on every frame.
+
+    **Two allowances, and what each forgives.** `ADVANCE_TOLERANCE_PX` is the
+    rasteriser's own grid. The second is the whole-pixel size: `draw` asks for
+    the size ImGui was going to bake at (`_baked`), so a face laid out at a
+    height of 18.75 px is drawn from the 19 px raster and every file advance is
+    1.3% short of it. That is `docs/subpixel.md` §5.1's trade, taken knowingly,
+    and it is not what this function is for, so an advance may also differ by
+    that proportion. A resolver that asks the atlas has neither difference.
+
+    A glyph is skipped when no face is loaded for its role or the face has no
+    raster for it: there is no baked advance to disagree with, and `DrawStats`
+    already counts the second.
+
+    Needs a current ImGui context whose backend flags carry
+    `renderer_has_textures`. Needs no frame and no draw list.
+    """
+    seen: dict[FontKey, set[int]] = {}
+    for cmd in cmds:
+        if isinstance(cmd, Glyph):
+            seen.setdefault(cmd.font, set()).add(cmd.codepoint)
+
+    glyphs = disagreeing = 0
+    worst = 0.0
+    for key, codepoints in seen.items():
+        spec = parse_font_key(key)
+        font = fonts(spec.face)
+        if font is None:
+            continue
+        ours = metrics(key)
+        size_px = baked_size_px(
+            px_from_sp(spec.size, px_per_inch), ours.ascent, ours.descent, ours.em
+        )
+        if size_px < 1.0:
+            continue
+        baked = _baked(font, size_px)
+        resized = abs(baked.size / size_px - 1.0)
+        for codepoint in sorted(codepoints):
+            if not font.is_glyph_in_font(codepoint):
+                continue
+            laid = ours.advance(codepoint) * px_from_sp(1, px_per_inch)
+            excess = abs(laid - baked.get_char_advance(codepoint)) - laid * resized
+            glyphs += 1
+            if excess > ADVANCE_TOLERANCE_PX:
+                disagreeing += 1
+                worst = max(worst, excess - ADVANCE_TOLERANCE_PX)
+    return AdvanceCheck(glyphs=glyphs, disagreeing=disagreeing, worst_px=worst)
+
