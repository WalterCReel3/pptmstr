+class Hinting(enum.Enum):
+    """
+    How the atlas's rasteriser fits a glyph to the pixel grid, as far as layout cares.
+
+    Layout cares because the mode decides the advance. On imgui-bundle 1.92.900
+    (FreeType 2.13.3), and held by `tests/test_hinting.py` for the faces, sizes
+    and characters it names:
+
+    - `DEFAULT`: the loader's own flags. Every advance is a whole pixel, and it
+      is not the file's advance rounded -- the font's own instructions choose
+      it. Roboto's `m` at a 14 px height is 10.47 px in the file and 11 here.
+    - `LIGHT`: FreeType's light target, which fits vertically only. Every
+      advance is still a whole pixel, and it *is* the file's advance rounded:
+      that `m` is 10.
+    - `NONE`: no hinting. The advance is the file's, to a hundredth of a pixel.
+
+    So `NONE` is the one mode under which `advtext.style.fontlib_metrics`
+    describes the raster, and `DEFAULT` and `LIGHT` are different rasters with
+    different advances: the mode is recorded so that `LoadedFaces.metrics` can
+    answer for the one that was baked.
+
+    Not here: the rest of the loader's flags (auto-hinter choice, mono hinting,
+    synthetic bold and oblique). A host that sets those through a loader of its
+    own has a raster this enum cannot name, and `baked_metrics` still measures
+    it, because it asks the atlas.
+    """
+
+    DEFAULT = "default"
+    LIGHT = "light"
+    NONE = "none"
