+def test_an_advance_is_read_from_the_atlas_once() -> None:
+    font = _Font({ord("A"): 9.0})
+    resolve = _resolver(font)
+
+    for _ in range(3):
+        resolve(KEY).advance(ord("A"))
+
+    assert len(font.asked) == 1
+    assert resolve(KEY) is resolve(KEY)
