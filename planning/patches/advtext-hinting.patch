+# ----------------------------------------------------------------------
+# The pairing, against the real atlas
+
+
+def test_metrics_is_the_file_s_resolver_when_nothing_was_hinted(
+    loaded: dict[Hinting, LoadedFaces],
+) -> None:
+    assert loaded[Hinting.NONE].metrics() is fontlib_metrics
+    assert loaded[Hinting.NONE].metrics(120.0) is fontlib_metrics
+
+
+@pytest.mark.parametrize("mode", [Hinting.DEFAULT, Hinting.LIGHT])
+def test_metrics_is_one_baked_resolver_a_density_when_the_faces_were_hinted(
+    loaded: dict[Hinting, LoadedFaces], mode: Hinting
+) -> None:
+    fonts = loaded[mode]
+
+    assert fonts.metrics() is fonts.metrics()
+    assert fonts.metrics() is not fontlib_metrics
+    assert fonts.metrics(120.0) is not fonts.metrics()
+    assert isinstance(fonts.metrics()(_key(Face.PROSE, 16.0)), BakedFaceMetrics)
