+# ----------------------------------------------------------------------
+# The resolver's rules, with round numbers
+
+
+class _Baked:
+    def __init__(self, advances: dict[int, float], asked: list[float], size: float) -> None:
+        self._advances = advances
+        self._asked = asked
+        self.size = size
+
+    def get_char_advance(self, codepoint: int) -> float:
+        return self._advances[codepoint]
+
+
+class _Font:
+    """
+    A loaded face that answers from a table, and records each size it is asked to bake.
+    """
+
+    def __init__(self, advances: dict[int, float]) -> None:
+        self.advances = advances
+        self.asked: list[float] = []
+
+    def is_glyph_in_font(self, codepoint: int) -> bool:
+        return codepoint in self.advances
+
+    def get_font_baked(self, size_px: float) -> _Baked:
+        self.asked.append(size_px)
+        return _Baked(self.advances, self.asked, float(snap_px(size_px)))
+
+
+class _FileMetrics:
+    """
+    A file whose every advance is 7.5 px and whose one kern, A before V, is -1.25 px.
+
+    The height is 1.25 em, so a key of 16 px is asked of the atlas at 20.
+    """
+
+    def __init__(self, key: str) -> None:
+        spec = parse_font_key(key)
+        self.face = spec.face
+        self.size = self.em = float(spec.size)
+        self.ascent = 1.0 * self.size
+        self.descent = 0.25 * self.size
+        self.x_height = 0.5 * self.size
+
+    @property
+    def space_width(self) -> float:
+        return self.advance(0x20)
+
+    def has(self, codepoint: int) -> bool:
+        return True
+
+    def advance(self, codepoint: int) -> float:
+        return float(sp_from_px(7.5))
+
+    def bbox(self, codepoint: int) -> GlyphBBox:
+        return GlyphBBox(0.0, -1.0, 2.0, 3.0)
+
+    def kern(self, codepoint: int, following: int) -> float:
+        return float(sp_from_px(-1.25)) if (codepoint, following) == (ord("A"), ord("V")) else 0.0
+
+
+KEY = font_key(Face.PROSE, sp_from_px(16.0))
+
+
+def _resolver(font: Any) -> Any:
+    return baked_metrics(lambda _face: font, file=_FileMetrics)
+
+
+def test_the_advance_is_the_atlas_s_at_the_size_draw_will_ask_for() -> None:
+    font = _Font({ord("A"): 9.0, 0x20: 4.0})
+    metrics = _resolver(font)(KEY)
+
+    assert px_from_sp(round(metrics.advance(ord("A")))) == pytest.approx(9.0, abs=1e-4)
+    assert px_from_sp(round(metrics.space_width)) == pytest.approx(4.0, abs=1e-4)
+    assert font.asked and all(size == pytest.approx(20.0, abs=1e-4) for size in font.asked)
+
+
+def test_everything_a_raster_does_not_define_is_the_file_s() -> None:
+    file = _FileMetrics(KEY)
+    metrics = _resolver(_Font({ord("A"): 9.0}))(KEY)
+
+    assert (metrics.face, metrics.size, metrics.em) == (file.face, file.size, file.em)
+    assert (metrics.ascent, metrics.descent, metrics.x_height) == (
+        file.ascent,
+        file.descent,
+        file.x_height,
+    )
+    assert metrics.bbox(ord("A")) == file.bbox(ord("A"))
+    assert metrics.has(0x2192)
+
+
+def test_a_glyph_the_face_lacks_and_a_role_with_no_face_take_the_file_s_advance() -> None:
+    file = _FileMetrics(KEY)
+
+    assert _resolver(_Font({}))(KEY).advance(ord("A")) == file.advance(ord("A"))
+    assert _resolver(None)(KEY).advance(ord("A")) == file.advance(ord("A"))
+
