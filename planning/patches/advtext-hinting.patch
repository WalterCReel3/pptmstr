+# ----------------------------------------------------------------------
+# The loader flag, and what the default leaves alone
+
+
+class _RecordingAtlas:
+    """
+    An atlas that keeps the arguments of every `add_font_from_file_ttf`.
+    """
+
+    def __init__(self) -> None:
+        self.calls: list[tuple[Any, ...]] = []
+
+    def add_font_from_file_ttf(self, *args: Any) -> str:
+        self.calls.append(args)
+        return "font"
+
+
+def test_the_default_mode_hands_the_atlas_no_config_at_all() -> None:
+    """
+    `Hinting.DEFAULT` is the call this module made before it knew about hinting.
+
+    Not a config with zero flags: no config, so nothing a host or a later
+    ImGui puts in `ImFontConfig`'s defaults can differ between the two.
+    """
+    atlas = _RecordingAtlas()
+    path = Path("/nowhere/Face.ttf")
+
+    assert atlas_loader(16.0, atlas)(path) == "font"
+    assert atlas_loader(16.0, atlas, hinting=Hinting.DEFAULT)(path) == "font"
+
+    assert atlas.calls == [(str(path), 16.0), (str(path), 16.0)]
+    assert load_faces((), loader=lambda _path: None).hinting is Hinting.DEFAULT
