.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
# scripts/make_dist.py stages its two exports and two builds here.
/build/
# hello_imgui slugifies a window title into an ini filename and writes it to the
# working directory unless ini_folder_type says otherwise. Ignored as a backstop;
# the fix is to set ini_folder_type at every runner construction site.
*.ini

# Session-local harness permissions, not shared project config.
.claude/settings.local.json

# scripts/screenshot.py writes here by default. Captures of one run, not
# reference images -- the verify_*.py scripts are what assert on rendering.
/shots/

# scripts/typeset_deps.py builds here: imscribe and imtypeset at the commits
# imscribe.ref and imtypeset.ref name, and the library built from them for this
# checkout's interpreter. Remade by `make deps`.
/.deps/

# Wheels downloaded by hand for an install with no network
# (`pip install --no-index --find-links .wheelhouse ...`). Somebody else's
# published files, never this repository's to carry.
/.wheelhouse/
